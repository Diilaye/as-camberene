# ==========================================================================
# Pile Docker — à copier en .env.docker puis à renseigner
# ==========================================================================
# Ce fichier porte les secrets : il ne doit jamais rejoindre le dépôt.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build

# Adresse publique du site. Sert à la fois d'origine autorisée pour l'API et
# d'URL d'API inscrite dans le bundle du site.
SITE_URL=https://ascambere.sn

# Deux secrets distincts, longs, tirés au hasard :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# Base de données
MONGO_DB=asc_camberene

# Port de la boucle locale vers lequel l'Apache de l'hôte transmet.
WEB_PORT=8080

# Gateway fconnect. Laisser vide tant que la plateforme n'est pas jointe :
# équipes, effectif et matchs viennent alors des données livrées avec le site.
FCONNECT_URL=
CLUB_ID=
